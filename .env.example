# Supabase project URL (Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Transaction pooler (port 6543) for the running app
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Session pooler (port 5432) for drizzle-kit push / migrations
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

PORT=8080
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:5173
API_URL=http://localhost:8080
BASE_PATH=/

# Optional. Local session auth is the default.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Payments. Keep PAYMENT_PROVIDER=dev until live Whop credentials exist.
PAYMENT_PROVIDER=dev
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# Storage. local writes to ./uploads. cloudinary is reserved for later.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_PROVIDER=
EMAIL_API_KEY=
LOG_LEVEL=info
